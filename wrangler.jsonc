{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaveyourtraces",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // No database_id on purpose: wrangler creates the database on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leaveyourtraces"
    }
  ],
  "observability": {
    "enabled": true
  }
}
